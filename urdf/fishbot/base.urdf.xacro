<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="base_xacro" params="length radius">
        <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>
        <link name="base_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${length}" radius="${radius}"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="${length}" radius="${radius}"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </collision>

            <xacro:cylinder_inertia m="1.0" h="${length}" r="${radius}"/>
        </link>

        <link name="base_footprint" />
        <joint name="base_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${length/2+0.032-0.001}" rpy="0 0 0"/>
        </joint>
        <gazebo reference="base_link">
            <visual>
                <material>
                    <ambient>1 1 1 1.0</ambient>
                    <diffuse>1 1 1 1.0</diffuse>
                    <specular>0.8 0.8 0.8 1.0</specular>
                    <emissive>0.0 0.0 0.0 1.0</emissive>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>
</robot>