<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>
        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.032"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder length="0.04" radius="0.032"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1 1 0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="1" h="0.04" r="0.032" />
        </link>
        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_wheel_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
        <!-- gazebo -->
        <gazebo reference="${wheel_name}_wheel_link">
            <visual>
                <material>
                    <ambient>0.0 0.0 0.0 1.0</ambient>
                    <diffuse>0.0 0.0 0.0 1.0</diffuse>
                    <specular>0.8 0.8 0.8 1.0</specular>
                    <emissive>0.0 0.0 0.0 1.0</emissive>
                </material>
            </visual>
            <mu1 value="20.0"/>
            <mu2 value="20.0"/>
            <kp value="1000000000.0"/>
            <kd value="1.0"/>
        </gazebo>
    </xacro:macro>
</robot>