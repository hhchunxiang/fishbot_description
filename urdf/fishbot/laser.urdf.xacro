<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="laser_xacro" params="xyz">
        <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>
        <link name="laser_cylinder_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.10" radius="0.01"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.10" radius="0.01"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="1" h="0.10" r="0.01"/>
        </link>
        <joint name="laser_cylinder_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>
        <link name="laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="1" h="0.02" r="0.02" />
        </link>
        <joint name="laser_joint" type="fixed">
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </joint>

        <!-- gazebo -->
        <gazebo reference="laser_cylinder_link">
            <visual>
                <material>
                    <ambient>1 1 1 1.0</ambient>
                    <diffuse>1 1 1 1.0</diffuse>
                    <specular>0.8 0.8 0.8 1.0</specular>
                    <emissive>0.0 0.0 0.0 1.0</emissive>
                </material>
            </visual>
        </gazebo>
        <gazebo reference="laser_link">
            <visual>
                <material>
                    <ambient>0 0 0 1.0</ambient>
                    <diffuse>00 0 0 1.0</diffuse>
                    <specular>0.8 0.8 0.8 1.0</specular>
                    <emissive>0.0 0.0 0.0 1.0</emissive>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>
</robot>